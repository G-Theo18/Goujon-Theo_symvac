{% extends "base.html.twig" %}

{% block body %}
<div class="container mt-5">

    <h1 class="text-warning mb-4">Création d'un vacataire</h1>

    <div class="card bg-dark border-secondary p-4">

        {{ form_start(form) }}

        <div class="form-errors text-danger mb-3">
            {{ form_errors(form.nom) }}
        </div>

        <div class="mb-3">
            {{ form_label(form.nom, null, { 'label_attr': {'class': 'form-label text-warning'} }) }}
            {{ form_widget(form.nom, { 'attr': {'class': 'form-control bg-dark text-light border-secondary'} }) }}
        </div>

        <div class="mt-3">
            {{ form_row(form.submit, { 'attr': {'class': 'btn btn-warning'} }) }}
        </div>

        {{ form_end(form) }}

    </div>

</div>
{% endblock %}