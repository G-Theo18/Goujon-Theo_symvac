{% extends 'base.html.twig' %}

{% block title %}SymVa - Mes vacataires{% endblock %}

{% block body %}
<div class="container mt-4">

    {% for message in app.flashes('success') %}
        <div class="alert alert-dismissible alert-success mt-4">
            {{ message }}
        </div>
    {% endfor %}

    <h1 class="text-warning">Mes vacataires</h1>

    <table class="table table-hover mt-4">
        <thead>
            <tr class="table-secondary">
                <th scope="col">Numéro</th>
                <th scope="col">Nom</th>
                <th scope="col">Modifier</th>
                <th scope="col">Supprimer</th>
            </tr>
        </thead>

        <tbody>
            {% for vacataire in vacataires %}
            <tr class="table-dark">
                <th scope="row">{{ vacataire.id }}</th>
                <td>{{ vacataire.nom }}</td>
                <td>
                    <a href="{{ path('vacataire_edit', {id: vacataire.id}) }}" 
                       class="btn btn-sm btn-warning">
                        Modifier
                    </a>
                </td>
                <td>
                    <form action="{{ path('vacataire_delete', {id: vacataire.id}) }}"
                          method="post"
                          style="display:inline-block;"
                          onsubmit="return confirm('Supprimer ce vacataire ?');">
                        <button class="btn btn-sm btn-danger">Supprimer</button>
                    </form>
                </td>

            </tr>
            {% endfor %}
        </tbody>
    </table>

    {{ knp_pagination_render(vacataires) }}
</div>
{% endblock %}
